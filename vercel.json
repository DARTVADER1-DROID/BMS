{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bms-c-api.onrender.com/:path*"
    },
    {
      "source": "/",
      "destination": "/frontend/frontend-a-volttrack.html"
    },
    {
      "source": "/volttrack",
      "destination": "/frontend/frontend-a-volttrack.html"
    },
    {
      "source": "/rul",
      "destination": "/frontend/frontend-b-rul.html"
    },
    {
      "source": "/cycles",
      "destination": "/frontend/frontend-c-cycles.html"
    },
    {
      "source": "/auth.js",
      "destination": "/frontend/auth.js"
    }
  ]
}

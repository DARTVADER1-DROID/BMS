{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bms-c-api.onrender.com/:path*"
    },
    {
      "source": "/",
      "destination": "/frontend-a-volttrack.html"
    },
    {
      "source": "/volttrack",
      "destination": "/frontend-a-volttrack.html"
    },
    {
      "source": "/rul",
      "destination": "/frontend-b-rul.html"
    },
    {
      "source": "/cycles",
      "destination": "/frontend-c-cycles.html"
    }
  ]
}

{
  "name": "bms-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "vue": "3.5.46",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "vite": "6.4.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.14"
  }
}

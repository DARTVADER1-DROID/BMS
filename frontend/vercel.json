{
  "version": 2,
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://bms-c-api.onrender.com/$1"
    },
    {
      "src": "^/$",
      "dest": "/frontend-a-volttrack.html"
    },
    {
      "src": "^/volttrack/?$",
      "dest": "/frontend-a-volttrack.html"
    },
    {
      "src": "^/rul/?$",
      "dest": "/frontend-b-rul.html"
    },
    {
      "src": "^/cycles/?$",
      "dest": "/frontend-c-cycles.html"
    }
  ]
}
